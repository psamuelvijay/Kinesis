    <!-- About -->
    <string name="about_title">About this app</string>
    <string name="about_purpose">This is a research demonstration application. It is one of two versions of the same product that differ only in how steps are estimated.</string>
    <string name="about_method_title">How steps are counted</string>
    <string name="about_method_gps">This version estimates steps from GPS movement only. It does not read the accelerometer, the gyroscope or the phone\'s step counter.</string>
    <string name="about_method_fusion">This version counts steps with the phone\'s physical step counter. GPS and motion consistency checks are not enabled in this build.</string>
    <string name="about_scope_title">What it is not</string>
    <string name="about_scope">It is not the final consumer application, and it has no incentives or payments of any kind.</string>
